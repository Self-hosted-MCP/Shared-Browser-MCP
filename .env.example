# Every setting for Shared Browser MCP. Copy to .env (or your server panel's environment settings) and fill it in.
# Never commit a real .env. Secrets: in Coolify, switch "Is Literal" on.

# ---- Addresses (your own domain) ----
PUBLIC_URL=https://mcp.example.com          # the AI app's door (/mcp), public, passphrase login
FRONT_URL=https://browser.example.com       # your own page (live browser, log, files, settings), behind Zero Trust
ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com # AI apps allowed to finish the login

# ---- Secrets ----
LOGIN_HASH=                                 # from: python3 scripts/hash_passphrase.py
SEARXNG_SECRET=                             # any long random text: openssl rand -hex 32

# ---- Zero Trust lock for your page ----
# (Cloudflare Zero Trust, Access, Applications, your page's app, Overview)
CF_ACCESS_TEAM_DOMAIN=                      # like yourteam.cloudflareaccess.com
CF_ACCESS_AUD=                              # the Application Audience (AUD) Tag
ACCESS_ENFORCE=1                            # keep 1 on a server. If the two above are empty, your page refuses everything

# ---- Optional ----
SERVER_PUBLIC_IP=                           # your server's public address(es), comma separated, so the browser can't reach the server through it
PAGESPEED_API_KEY=                          # free key from Google Cloud, for the pagespeed_check tool
CHROME_NO_SANDBOX=0                         # set 1 ONLY if the server refuses Chromium's sandbox (see docs/troubleshooting.md)
TZ=UTC                                      # the clock for the browser and the action log, like Europe/Berlin
